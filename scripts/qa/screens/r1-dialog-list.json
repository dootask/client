        },
        {
          "name": "分类条",
          "old": ".messenger-nav",
          "new": "[data-testid=dialog-nav]",
          "props": [
            "padding-left",
            "padding-bottom"
          ]
        },
        {
          "name": "分类·全部",
          "old": ".messenger-nav .nav-list .nav-item:has-text(\"全部\") .nav-title",
          "new": "[data-testid=dialog-nav] :text-is(\"全部\")",
          "props": [
            "font-size",
            "font-weight",
            "color"
          ],
          "text": true
        },
        {
          "name": "分类·单聊",
          "old": ".messenger-nav .nav-list .nav-item:has-text(\"单聊\") .nav-title",
          "new": "[data-testid=dialog-nav] :text-is(\"单聊\")",
          "props": [
            "font-size",
            "font-weight",
            "color"
          ],
          "text": true,
          "ignore": [
            "left"
          ]
        },
        {
          "name": "首行会话",
          "old": "li[data-type=dialog] >> nth=0",
          "new": "[data-testid=dialog-row] >> nth=0",
          "props": [
            "background-color"
          ]
        },
        {
          "name": "底栏",
          "old": ".messenger-menu",
          "new": "[data-testid=dialog-bar]",
          "props": [
            "border-top-width",
            "border-top-color"
