        "path": "/manage/messenger",
        "state": "state-old-admin.json",
        "steps": [
          {
            "waitFor": "li[data-type=dialog]"
          }
        ]
      },
      "new": {
        "path": "/messenger",
        "state": "state-admin.json",
        "steps": [
          {
            "waitFor": "[data-testid=dialog-row]"
