        ]
      },
      "clip": {
        "old": ".messenger-select",
        "new": "[data-testid=dialog-list]"
      },
      "elements": [
        {
          "name": "列表栏",
          "old": ".messenger-select",
          "new": "[data-testid=dialog-list]",
          "props": [
            "background-color"
          ]
        },
        {
          "name": "搜索框",
          "old": ".messenger-search .search-wrapper",
          "new": "[data-testid=dialog-search]",
          "props": [
            "border-radius",
            "background-color"
          ]
        },
        {
          "name": "搜索输入",
          "old": ".messenger-search input",
          "new": "[data-testid=dialog-search] input",
          "props": [
            "font-size",
            "color",
            "padding-left"
