      "old": {
        "path": "/manage/messenger",
        "state": "state-old-admin.json",
        "steps": [
          {
            "click": "li[data-id=\"5805\"]"
          },
          {
            "waitFor": ".dialog-item"
          },
          {
            "wait": 1500
          },
          {
            "rightClick": ".dialog-item:not(.self) >> nth=-1 >> .dialog-content"
          },
          {
            "waitFor": ".dialog-wrapper-operate"
          },
          {
            "wait": 800
          }
        ]
      },
      "new": {
        "path": "/messenger/5805",
        "state": "state-admin.json",
        "steps": [
          {
            "waitFor": "[data-testid=msg-row]"
          },
          {
            "wait": 800
          },
          {
            "rightClick": "[data-testid=msg-row] >> nth=-1 >> [data-testid=msg-content]"
          },
          {
            "waitFor": "[data-testid=msg-menu]"
          },
          {
            "wait": 800
          }
        ]
      },
      "clip": {
        "old": ".dialog-msgs",
        "new": "[data-testid=msg-list]"
      },
      "elements": [
        {
          "name": "菜单面板",
          "old": ".dialog-wrapper-operate",
          "new": "[data-testid=msg-menu] >> xpath=..",
          "props": [
            "background-color",
            "border-radius",
            "padding",
            "box-shadow"
          ],
          "ignore": [
            "left",
            "top"
          ]
        },
        {
          "name": "操作区",
          "old": ".operate-action",
          "new": "[data-testid=msg-menu] > div:first-child",
