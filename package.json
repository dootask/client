    "@types/node": "^26.6.5",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.24",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~58.0.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.12"
  }
