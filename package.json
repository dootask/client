{
  "name": "dootask-client",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "node scripts/start.mjs",
    "web:export": "expo export --platform web",
    "web:preview": "node scripts/serve-web.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run i18n:check",
    "i18n:check": "node scripts/check-i18n.mjs",
    "i18n:find": "node scripts/i18n-find.mjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.14",
    "expo": "~58.0.14",
    "expo-constants": "~58.0.14",
    "expo-dev-client": "~58.0.14",
    "expo-linking": "~58.0.13",
    "expo-router": "~58.0.23",
    "expo-status-bar": "~58.0.3",
    "expo-system-ui": "~58.0.6",
    "i18next": "^27.0.1",
    "lucide-react-native": "1.66.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-i18next": "^18.0.0",
    "react-native": "0.88.0",
    "react-native-edge-to-edge": "1.8.2",
    "react-native-gesture-handler": "~3.3.0",
