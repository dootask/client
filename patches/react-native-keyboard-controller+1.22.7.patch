+  /// Resigns the current first responder right away instead of postponing it to the next frame.
+  /// Needed right before an interactive pop transition starts: once it has started, UIKit keeps
+  /// the keyboard attached to the page, so a postponed resign is too late.
+  public static func resignCurrentImmediately() {
+    guard let responder = UIResponder.current else { return }
+    if let textInput = responder as? TextInput, textInput.inputAccessoryView is InvisibleInputAccessoryView {
+      KeyboardAreaExtender.shared.hide()
+      NotificationCenter.default.post(
+        name: .shouldIgnoreKeyboardEvents, object: nil, userInfo: ["ignore": false]
+      )
+      textInput.inputAccessoryView = nil
+      KeyboardAreaExtender.shared.remove()
+    }
+    _ = responder.callOriginalResignFirstResponder(#selector(resignFirstResponder))
+  }
+
