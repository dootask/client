 @implementation RNSScreenStackView {
   UINavigationController *_controller;
   NSMutableArray<RNSScreenView *> *_reactSubviews;
@@ -938,6 +943,18 @@ RNS_IGNORE_SUPER_CALL_END
 
     // _UIParallaxTransitionPanGestureRecognizer (other...)
     [self cancelTouchesInParent];
+    // Dismiss the keyboard before the interactive transition starts. Resigning it in viewWillDisappear
+    // is too late: during an interactive pop UIKit keeps the keyboard attached to the page instead of
